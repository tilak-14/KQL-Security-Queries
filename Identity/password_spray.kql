// ============================================
// QUERY: Password Spray Detection
// MITRE: T1110.003 - Password Spraying
// DESCRIPTION: One IP targeting many users with few failures each
// SEVERITY: Critical
// TUNE: TargetedUsers > 10 threshold
// ============================================

// === REAL SENTINEL VERSION ===
// SigninLogs
// | where TimeGenerated > ago(1h)
// | where ResultType != "0"
// | summarize TargetedUsers = dcount(UserPrincipalName), FailCount = count()
//     by IPAddress
// | where TargetedUsers > 10
// | sort by TargetedUsers desc

// === PRACTICE VERSION ===
StormEvents
| where DeathsDirect > 0
| summarize TargetedStates = dcount(State), TotalHits = count()
    by EventType
| where TargetedStates > 5
| sort by TargetedStates desc