// ============================================
// QUERY: Mass File Download from SharePoint
// MITRE: T1039 - Data from Network Shared Drive
// DESCRIPTION: User downloading 50+ files in 1 hour
// SEVERITY: High
// TUNE: 50 file threshold - adjust for your org
// ============================================

// === REAL SENTINEL VERSION ===
// OfficeActivity
// | where TimeGenerated > ago(1d)
// | where Operation in ("FileDownloaded", "FileSyncDownloadedFull")
// | summarize DownloadCount = count(), UniqueFiles = dcount(OfficeObjectId),
//     IPAddresses = make_set(ClientIP)
//     by UserId, bin(TimeGenerated, 1h)
// | where DownloadCount > 50
// | sort by DownloadCount desc

// === PRACTICE VERSION ===
StormEvents
| summarize DownloadCount = count(), UniqueTargets = dcount(State),
    SourceList = make_set(Source)
    by EventType, bin(StartTime, 30d)
| where DownloadCount > 20
| sort by DownloadCount desc
| take 15