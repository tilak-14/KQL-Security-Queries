// === PRACTICE VERSION ===
let HighFrequency = StormEvents
| summarize HitCount = count() by Source
| where HitCount > 10
| project Source;
let CausedDamage = StormEvents
| where DamageProperty > 1000000
| summarize TotalDamage = sum(DamageProperty) by Source
| project Source, TotalDamage;
let SpreadWide = StormEvents
| summarize StatesHit = dcount(State), StateList = make_set(State) by Source
| where StatesHit > 3
| project Source, StatesHit, StateList;
HighFrequency
| join kind=inner CausedDamage on Source
| join kind=inner SpreadWide on Source
| project Source, TotalDamage, StatesHit, StateList
| sort by StatesHit desc