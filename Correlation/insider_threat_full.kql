// | sort by RuleTime desc

// === PRACTICE VERSION ===
let MassActivity = StormEvents
| summarize Events = count() by Source
| where Events > 15
| project Source;
let LongTermPresence = StormEvents
| summarize FirstSeen = min(StartTime), LastSeen = max(StartTime) by Source
| extend ActiveDays = datetime_diff("day", LastSeen, FirstSeen)
| where ActiveDays > 300
| project Source, ActiveDays;
let NewLocations = StormEvents
| summarize UniqueStates = dcount(State), StateList = make_set(State) by Source
| where UniqueStates > 4
| project Source, UniqueStates, StateList;
MassActivity
| join kind=inner LongTermPresence on Source
| join kind=inner NewLocations on Source
| project Source, ActiveDays, UniqueStates, StateList
| sort by UniqueStates desc