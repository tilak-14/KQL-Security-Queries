// === PRACTICE VERSION ===
let TargetSource = toscalar(
    StormEvents
    | summarize Events = count() by Source
    | top 1 by Events desc
    | project Source);
let Phase1 = StormEvents
| where Source == TargetSource and DeathsDirect > 0
| project Timestamp=StartTime, Stage="1-Initial Strike",
    Detail=strcat(EventType, " Deaths:", tostring(DeathsDirect));
let Phase2 = StormEvents
| where Source == TargetSource and InjuriesDirect > 5
| project Timestamp=StartTime, Stage="2-Escalation",
    Detail=strcat(EventType, " Injuries:", tostring(InjuriesDirect));
let Phase3 = StormEvents
| where Source == TargetSource and DamageProperty > 1000000
| project Timestamp=StartTime, Stage="3-Mass Impact",
    Detail=strcat(EventType, " Damage:", tostring(DamageProperty));
Phase1 | union Phase2 | union Phase3
| sort by Timestamp asc
| take 20